{
    "layer": "top",
    "position": "top",
    "height": 24,
    "modules-left": ["custom/session", "clock"],
    "modules-center": ["sway/workspaces"],
    "modules-right": ["pulseaudio", "network", "bluetooth", "battery"],

    "custom/session": {
        "format": " 󱄅 |",
        "tooltip": false,
        "on-click": ""
    },

    "clock": {
        "format": "{:%I:%M} |"
    },

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "persistent-workspaces": {
            "1": [],
            "2": []
        },
            "active": "■",
            "default": "1"
        }
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid}"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}"
    },

    "battery": {
        "format": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}%"
    }
}
